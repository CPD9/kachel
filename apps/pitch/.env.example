# Mapbox public access token (pk.…), from https://account.mapbox.com/access-tokens/.
# Anything in a VITE_ variable ends up in the browser bundle: use a public token, ideally URL-restricted.
# Optional: without it the intro skips the globe and goes straight to the map (apps/map).
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Where the map app runs, for the hand-over after the intro (default http://localhost:5175).
# VITE_MAP_URL=http://localhost:5175

# The operator console, for the market's last step (default http://localhost:5177 in dev,
# https://operator-omega-jade.vercel.app in a deployed build).
# VITE_OPERATOR_URL=http://localhost:5177
