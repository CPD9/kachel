# Local Supabase: run `make dev`, then copy the values from `pnpm exec supabase status -o env`:
# API_URL, and ANON_KEY or PUBLISHABLE_KEY. Never SERVICE_ROLE_KEY or SECRET_KEY: anything in a
# VITE_ variable ends up in the browser bundle. Local stack only.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=local-anon-or-publishable-key-from-supabase-status

# Ask your house (#26): Ollama on this computer, with qwen3:4b pulled. Only localhost is allowed.
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=qwen3:4b
