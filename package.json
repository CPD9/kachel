{
  "name": "kachel",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "readme:check": "node scripts/readme-check.mjs && node scripts/readme-figures.mjs --check",
    "prepare": "husky",
    "readme:figures": "node scripts/readme-figures.mjs",
    "db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts && prettier --write packages/db/src/database.types.ts"
  },
  "devDependencies": {
    "@kachel/config": "workspace:*",
    "eslint": "10.15.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "supabase": "2.122.1",
    "turbo": "2.11.13"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md,yml,yaml,css}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix",
    "{scripts,services/agent}/**/*.py": [
      "uv run --project services/agent ruff format",
      "uv run --project services/agent ruff check --fix"
    ],
    "services/scheduler/tests/**/*.py": [
      "uv run --project services/scheduler ruff format",
      "uv run --project services/scheduler ruff check --fix"
    ]
  }
}
