# Local Supabase: run `make dev`, then copy the values from `pnpm exec supabase status -o env`:
# API_URL, and SERVICE_ROLE_KEY or SECRET_KEY. Local stack only.
# The service role key is read here only, from the environment. It never goes in a client bundle.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=local-service-role-or-secret-key-from-supabase-status
# The agent writes job and server state only when given both rows, for example:
#   set -a; . services/agent/.env; set +a
#   uv run --project services/agent python -m kachel_agent --pid <pid> --signal /tmp/heat \
#     --job-id 00000000-0000-4000-8000-000000000304 --server-id 00000000-0000-4000-8000-000000000204
